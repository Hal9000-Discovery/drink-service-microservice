{
  "info": {
    "_postman_id": "drink-service-collection",
    "name": "DrinkService API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/health"
      }
    },
    {
      "name": "Get All Drinks",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/drinks"
      }
    },
    {
      "name": "Create Drink",
      "request": {
        "method": "POST",
        "header": [{
          "key": "Content-Type",
          "value": "application/json"
        }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"{{sample_drink_name}}\",\n  \"description\": \"{{sample_drink_description}}\"\n}"
        },
        "url": "{{base_url}}/drinks"
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "var json = pm.response.json();",
            "if (json.id) { pm.environment.set('drink_id', json.id); }"
          ]
        }
      }]
    },
    {
      "name": "Get Drink by ID",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/drinks/{{drink_id}}"
      }
    },
    {
      "name": "Get All Prices",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/prices"
      }
    },
    {
      "name": "Create Price",
      "request": {
        "method": "POST",
        "header": [{
          "key": "Content-Type",
          "value": "application/json"
        }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"drink_id\": {{drink_id}},\n  \"price_amount\": \"{{sample_price_amount}}\",\n  \"effective_date\": \"{{sample_price_effective_date}}\",\n  \"end_date\": \"{{sample_price_end_date}}\"\n}"
        },
        "url": "{{base_url}}/prices"
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "var json = pm.response.json();",
            "if (json.price_id) { pm.environment.set('price_id', json.price_id); }"
          ]
        }
      }]
    },
    {
      "name": "Get Price by ID",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/prices/{{price_id}}"
      }
    }
  ]
}
