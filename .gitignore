# ===============================================
# PYTHON & ENVIRONMENT SETTINGS
# ===============================================

# Ignore Python cache and virtual environments
__pycache__/
*.pyc
*.pyo
*.pyd
*.pdb
.venv/
venv/
env/
ENV/

# ===============================================
# ENVIRONMENT FILES
# ===============================================
# Ignore real environment secrets
.env
*.env.local
*.env.secret
# Allow example env templates
!*.env.example

# ===============================================
# LOGS, TEST OUTPUTS, and MISC
# ===============================================
*.log
*.tmp
*.bak
*.swp

# ===============================================
# IDE / TOOLING
# ===============================================
.vscode/
.idea/
.DS_Store

# ===============================================
# DATABASE FILES
# ===============================================
# Ignore all database files
*.db
*.sqlite
*.sqlite3
*.sqbpro
# But keep test data SQL files
!data/*.sql