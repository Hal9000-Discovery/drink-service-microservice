<?xml version="1.0" encoding="UTF-8"?>
<con:testSuite 
    name="DrinkService Regression Suite"
    xmlns:con="http://eviware.com/soapui/config">

    <!-- ============================
         Test Case 1 — GET /drinks
    ============================ -->
    <con:testCase name="Get All Drinks">
        <con:testStep type="restrequest" name="GET All Drinks">
            <con:restRequest methodName="GET" service="http://localhost:5002" resourcePath="/drinks">
                <con:endpoint>${#Project#BaseURL}</con:endpoint>

                <!-- Expect 200 OK -->
                <con:assertion type="ValidHttpStatusCodes">
                    <con:statusCodes>200</con:statusCodes>
                </con:assertion>
            </con:restRequest>
        </con:testStep>
    </con:testCase>


    <!-- ============================
         Test Case 2 — POST /drinks
    ============================ -->
    <con:testCase name="Create Drink">
        <con:properties>
            <con:property 
                name="drinkName" 
                value="AutoDrink-${=System.currentTimeMillis()}"/>
        </con:properties>

        <con:testStep type="restrequest" name="POST Create Drink">
            <con:restRequest methodName="POST" service="http://localhost:5002" resourcePath="/drinks">
                <con:endpoint>${#Project#BaseURL}</con:endpoint>
                <con:mediaType>application/json</con:mediaType>

                <con:request>
{
    "name": "${#TestCase#drinkName}",
    "description": "Created by automated SoapUI test"
}
                </con:request>

                <!-- Expect 201 Created -->
                <con:assertion type="ValidHttpStatusCodes">
                    <con:statusCodes>201</con:statusCodes>
                </con:assertion>
            </con:restRequest>
        </con:testStep>
    </con:testCase>


    <!-- ============================
         Test Case 3 — GET /drinks/{id}
         NOTE: Using drinkId = 1 for now
    ============================ -->
    <con:testCase name="Get Drink By ID">
        <con:properties>
            <con:property name="drinkId" value="1"/>
        </con:properties>

        <con:testStep type="restrequest" name="GET Drink By ID">
            <con:restRequest methodName="GET" service="http://localhost:5002" resourcePath="/drinks/${#TestCase#drinkId}">
                <con:endpoint>${#Project#BaseURL}</con:endpoint>

                <!-- Expect 200 OK -->
                <con:assertion type="ValidHttpStatusCodes">
                    <con:statusCodes>200</con:statusCodes>
                </con:assertion>
            </con:restRequest>
        </con:testStep>
    </con:testCase>


    <!-- ============================
         Test Case 4 — POST /prices
    ============================ -->
    <con:testCase name="Create Price">
        <con:properties>
            <con:property 
                name="priceAmount" 
                value="${=Math.floor(Math.random()*5)+1}.${=Math.floor(Math.random()*99)}"/>
        </con:properties>

        <con:testStep type="restrequest" name="POST Create Price">
            <con:restRequest methodName="POST" service="http://localhost:5002" resourcePath="/prices">
                <con:endpoint>${#Project#BaseURL}</con:endpoint>
                <con:mediaType>application/json</con:mediaType>

                <con:request>
{
    "drink_id": 1,
    "price_amount": "${#TestCase#priceAmount}",
    "effective_date": "2025-01-01",
    "end_date": null
}
                </con:request>

                <!-- Expect 201 Created -->
                <con:assertion type="ValidHttpStatusCodes">
                    <con:statusCodes>201</con:statusCodes>
                </con:assertion>
            </con:restRequest>
        </con:testStep>
    </con:testCase>

</con:testSuite>
